\deqn{
ENT^* = 2N^* \left[
  \pi \left( \frac{D(\theta_1 - p_d)C}{\phi_1} + p_d p_+ \right)
  + (1 - \pi)\left( \frac{D(0.5 - p_d)C}{\phi_1} + p_d p_+ \right)
