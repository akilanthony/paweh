\deqn{
Z = (1 - p_d)^2 + 2 p_d (1 - p_d) R_1 + p_d^2 R_2, \quad
f_0 = \phi_1 / Z, \quad f_1 = R_1 f_0, \quad f_2 = R_2 f_0.
